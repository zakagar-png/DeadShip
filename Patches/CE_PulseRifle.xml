<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Only when Combat Extended is installed: the pulse rifle gets a 30 round magazine, uses its own pulse rounds, made at the machining table, and fires a weak CE projectile. It has single, 3-round burst and full-auto (10 rounds) modes. -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Combat Extended</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>

        <li Class="PatchOperationAdd">
          <xpath>Defs</xpath>
          <value>
            <ThingDef Class="CombatExtended.AmmoDef" ParentName="SmallAmmoBase">
              <defName>DS_Ammo_PulseRound</defName>
              <label>pulse round</label>
              <description>A sealed plasma canister for a pulse rifle. Each one feeds a single bolt.</description>
              <graphicData>
                <texPath>Things/Ammo/DS_PulseRound</texPath>
                <graphicClass>Graphic_Single</graphicClass>
                <drawSize>0.7</drawSize>
              </graphicData>
              <statBases>
                <Mass>0.015</Mass>
                <Bulk>0.03</Bulk>
                <MarketValue>0.6</MarketValue>
              </statBases>
              <ammoClass>FullMetalJacket</ammoClass>
              <cookOffProjectile>DS_Bullet_PulseRifleCE</cookOffProjectile>
              <recipeMaker>
                <recipeUsers Inherit="False">
                  <li>TableMachining</li>
                </recipeUsers>
                <researchPrerequisite>DS_PulseRifle</researchPrerequisite>
                <workAmount>700</workAmount>
                <productCount>40</productCount>
              </recipeMaker>
              <costList>
                <Steel>12</Steel>
                <ComponentIndustrial>1</ComponentIndustrial>
              </costList>
            </ThingDef>

            <CombatExtended.AmmoSetDef>
              <defName>AmmoSet_DS_PulseRifle</defName>
              <label>pulse round</label>
              <ammoTypes>
                <DS_Ammo_PulseRound>DS_Bullet_PulseRifleCE</DS_Ammo_PulseRound>
              </ammoTypes>
            </CombatExtended.AmmoSetDef>

            <ThingDef ParentName="BaseBullet">
              <defName>DS_Bullet_PulseRifleCE</defName>
              <label>plasma pulse</label>
              <thingClass>CombatExtended.BulletCE</thingClass>
              <graphicData>
                <texPath>Things/Projectile/Bullet_Small</texPath>
                <graphicClass>Graphic_Single</graphicClass>
                <shaderType>TransparentPostLight</shaderType>
                <color>(90,230,255)</color>
              </graphicData>
              <projectile Class="CombatExtended.ProjectilePropertiesCE">
                <damageDef>DS_PlasmaCut</damageDef>
                <damageAmountBase>6</damageAmountBase>
                <speed>130</speed>
                <armorPenetrationSharp>12</armorPenetrationSharp>
                <armorPenetrationBlunt>14</armorPenetrationBlunt>
                <secondaryDamage>
                  <li>
                    <def>Burn</def>
                    <amount>3</amount>
                  </li>
                </secondaryDamage>
              </projectile>
            </ThingDef>
          </value>
        </li>

        <!-- Pulse penetrators: a second ammo type for the pulse rifle (Pulse Penetrators research). -->
        <li Class="PatchOperationAdd">
          <xpath>Defs</xpath>
          <value>
            <ThingDef Class="CombatExtended.AmmoDef" ParentName="SmallAmmoBase">
              <defName>DS_Ammo_PulseRound_AP</defName>
              <label>pulse penetrator</label>
              <description>A narrow, hotter pulse round. Weak against flesh, made to go through armour.</description>
              <graphicData>
                <texPath>Things/Ammo/DS_PulseRound</texPath>
                <graphicClass>Graphic_Single</graphicClass>
                <drawSize>0.7</drawSize>
                <color>(255,170,90)</color>
              </graphicData>
              <statBases>
                <Mass>0.016</Mass>
                <Bulk>0.03</Bulk>
                <MarketValue>0.9</MarketValue>
              </statBases>
              <ammoClass>ArmorPiercing</ammoClass>
              <cookOffProjectile>DS_Bullet_PulseRifleCE_AP</cookOffProjectile>
              <recipeMaker>
                <recipeUsers Inherit="False">
                  <li>TableMachining</li>
                </recipeUsers>
                <researchPrerequisite>DS_PulsePenetrators</researchPrerequisite>
                <workAmount>800</workAmount>
                <productCount>40</productCount>
              </recipeMaker>
              <costList>
                <Steel>14</Steel>
                <ComponentIndustrial>2</ComponentIndustrial>
              </costList>
            </ThingDef>
            <ThingDef ParentName="BaseBullet">
              <defName>DS_Bullet_PulseRifleCE_AP</defName>
              <label>plasma penetrator</label>
              <thingClass>CombatExtended.BulletCE</thingClass>
              <graphicData>
                <texPath>Things/Projectile/Bullet_Small</texPath>
                <graphicClass>Graphic_Single</graphicClass>
                <shaderType>TransparentPostLight</shaderType>
                <color>(255,190,90)</color>
              </graphicData>
              <projectile Class="CombatExtended.ProjectilePropertiesCE">
                <damageDef>DS_PlasmaCut</damageDef>
                <damageAmountBase>5</damageAmountBase>
                <speed>140</speed>
                <armorPenetrationSharp>24</armorPenetrationSharp>
                <armorPenetrationBlunt>28</armorPenetrationBlunt>
                <secondaryDamage>
                  <li>
                    <def>Burn</def>
                    <amount>2</amount>
                  </li>
                </secondaryDamage>
              </projectile>
            </ThingDef>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/CombatExtended.AmmoSetDef[defName="AmmoSet_DS_PulseRifle"]/ammoTypes</xpath>
          <value>
            <DS_Ammo_PulseRound_AP>DS_Bullet_PulseRifleCE_AP</DS_Ammo_PulseRound_AP>
          </value>
        </li>

        <!-- Hollow points: a third ammo type, best against flesh (Hollow Points research). -->
        <li Class="PatchOperationAdd">
          <xpath>Defs</xpath>
          <value>
            <ThingDef Class="CombatExtended.AmmoDef" ParentName="SmallAmmoBase">
              <defName>DS_Ammo_PulseRound_HP</defName>
              <label>pulse hollow point</label>
              <description>A soft-cased pulse round that spreads on impact. Hits flesh far harder than the standard round, but stops dead against armour.</description>
              <graphicData>
                <texPath>Things/Ammo/DS_PulseRound</texPath>
                <graphicClass>Graphic_Single</graphicClass>
                <drawSize>0.7</drawSize>
                <color>(255,90,110)</color>
              </graphicData>
              <statBases>
                <Mass>0.015</Mass>
                <Bulk>0.03</Bulk>
                <MarketValue>0.8</MarketValue>
              </statBases>
              <ammoClass>HollowPoint</ammoClass>
              <cookOffProjectile>DS_Bullet_PulseRifleCE_HP</cookOffProjectile>
              <recipeMaker>
                <recipeUsers Inherit="False">
                  <li>TableMachining</li>
                </recipeUsers>
                <researchPrerequisite>DS_HollowPoints</researchPrerequisite>
                <workAmount>750</workAmount>
                <productCount>40</productCount>
              </recipeMaker>
              <costList>
                <Steel>12</Steel>
                <ComponentIndustrial>1</ComponentIndustrial>
              </costList>
            </ThingDef>
            <ThingDef ParentName="BaseBullet">
              <defName>DS_Bullet_PulseRifleCE_HP</defName>
              <label>plasma hollow point</label>
              <thingClass>CombatExtended.BulletCE</thingClass>
              <graphicData>
                <texPath>Things/Projectile/Bullet_Small</texPath>
                <graphicClass>Graphic_Single</graphicClass>
                <shaderType>TransparentPostLight</shaderType>
                <color>(255,110,130)</color>
              </graphicData>
              <projectile Class="CombatExtended.ProjectilePropertiesCE">
                <damageDef>DS_PlasmaCut</damageDef>
                <damageAmountBase>11</damageAmountBase>
                <speed>120</speed>
                <armorPenetrationSharp>3</armorPenetrationSharp>
                <armorPenetrationBlunt>6</armorPenetrationBlunt>
                <secondaryDamage>
                  <li>
                    <def>Burn</def>
                    <amount>4</amount>
                  </li>
                </secondaryDamage>
              </projectile>
            </ThingDef>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/CombatExtended.AmmoSetDef[defName="AmmoSet_DS_PulseRifle"]/ammoTypes</xpath>
          <value>
            <DS_Ammo_PulseRound_HP>DS_Bullet_PulseRifleCE_HP</DS_Ammo_PulseRound_HP>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="DS_PulseRifle"]/verbs</xpath>
          <value>
            <verbs>
              <li Class="CombatExtended.VerbPropertiesCE">
                <verbClass>CombatExtended.Verb_ShootCE</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>DS_Bullet_PulseRifleCE</defaultProjectile>
                <warmupTime>1.0</warmupTime>
                <range>40</range>
                <!-- burstShotCount is the full-auto burst; the three-round burst mode is aimedBurstShotCount below. -->
                <burstShotCount>10</burstShotCount>
                <ticksBetweenBurstShots>5</ticksBetweenBurstShots>
                <soundCast>Shot_AssaultRifle</soundCast>
                <soundCastTail>GunTail_Medium</soundCastTail>
                <muzzleFlashScale>9</muzzleFlashScale>
                <recoilAmount>1.1</recoilAmount>
              </li>
            </verbs>
          </value>
        </li>

        <!-- CE melee tools so the info card can show melee stats. -->
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="DS_PulseRifle"]/tools</xpath>
          <value>
            <tools>
              <li Class="CombatExtended.ToolCE">
                <label>stock</label>
                <capacities>
                  <li>Blunt</li>
                </capacities>
                <power>9</power>
                <cooldownTime>2</cooldownTime>
                <armorPenetrationBlunt>0.5</armorPenetrationBlunt>
                <linkedBodyPartsGroup>Hands</linkedBodyPartsGroup>
              </li>
              <li Class="CombatExtended.ToolCE">
                <label>barrel</label>
                <capacities>
                  <li>Blunt</li>
                  <li>Poke</li>
                </capacities>
                <power>9</power>
                <cooldownTime>2</cooldownTime>
                <armorPenetrationBlunt>0.5</armorPenetrationBlunt>
                <linkedBodyPartsGroup>Hands</linkedBodyPartsGroup>
              </li>
            </tools>
          </value>
        </li>

        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="DS_PulseRifle"]/statBases</xpath>
          <value>
            <Bulk>8</Bulk>
            <SwayFactor>1.3</SwayFactor>
            <ShotSpread>0.1</ShotSpread>
            <SightsEfficiency>1</SightsEfficiency>
          </value>
        </li>

        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="DS_PulseRifle"]</xpath>
          <value>
            <comps>
              <li Class="CombatExtended.CompProperties_AmmoUser">
                <magazineSize>30</magazineSize>
                <reloadTime>4</reloadTime>
                <ammoSet>AmmoSet_DS_PulseRifle</ammoSet>
              </li>
              <li Class="CombatExtended.CompProperties_FireModes">
                <aimedBurstShotCount>3</aimedBurstShotCount>
                <aiUseBurstMode>TRUE</aiUseBurstMode>
                <aiAimMode>Snapshot</aiAimMode>
              </li>
            </comps>
          </value>
        </li>

        <!-- Salvage crew start: pulse rounds for the rifle. -->
        <li Class="PatchOperationAdd">
          <xpath>Defs/ScenarioDef[defName="DS_SalvageCrew"]/scenario/parts</xpath>
          <value>
            <li Class="ScenPart_StartingThing_Defined">
              <def>StartingThing_Defined</def>
              <thingDef>DS_Ammo_PulseRound</thingDef>
              <count>180</count>
            </li>
          </value>
        </li>

      </operations>
    </match>
  </Operation>

</Patch>
