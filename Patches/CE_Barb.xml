<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Only when Combat Extended is installed: the lurker's barb and the puker's acid spit become real CE projectiles,
       fired by Source/CompBarbVolley.cs through Source/CELauncher.cs. Without CE the lurker uses
       the picture-only barbs in Defs/FleckDefs/Barb.xml instead. -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Combat Extended</li>
    </mods>
    <match Class="PatchOperationAdd">
      <xpath>Defs</xpath>
      <value>
        <ThingDef ParentName="BaseArrowProjectile">
          <defName>DS_Projectile_Barb</defName>
          <label>tentacle barb</label>
          <graphicData>
            <texPath>Things/Projectile/DS_Barb_up</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>0.8</drawSize>
          </graphicData>
          <projectile Class="CombatExtended.ProjectilePropertiesCE">
            <speed>45</speed>
            <damageDef>Stab</damageDef>
            <damageAmountBase>7</damageAmountBase>
            <armorPenetrationSharp>1.2</armorPenetrationSharp>
            <armorPenetrationBlunt>2.0</armorPenetrationBlunt>
          </projectile>
        </ThingDef>
        <!-- The puker's acid spit. Burns, eats armour, leaves a puddle (Source/AcidProjectileCE.cs). -->
        <ThingDef ParentName="BaseArrowProjectile">
          <defName>DS_Projectile_AcidSpit</defName>
          <label>acid spit</label>
          <thingClass>DeadShip.AcidProjectileCE</thingClass>
          <graphicData>
            <texPath>Things/Projectile/DS_AcidSpit_up</texPath>
            <graphicClass>Graphic_Single</graphicClass>
          </graphicData>
          <projectile Class="CombatExtended.ProjectilePropertiesCE">
            <speed>35</speed>
            <damageDef>Burn</damageDef>
            <damageAmountBase>9</damageAmountBase>
            <armorPenetrationSharp>1.0</armorPenetrationSharp>
            <armorPenetrationBlunt>1.0</armorPenetrationBlunt>
          </projectile>
          <modExtensions>
            <li Class="DeadShip.AcidProjectileExtension">
              <armorWear>12</armorWear>
            </li>
          </modExtensions>
        </ThingDef>
      </value>
    </match>
  </Operation>

</Patch>
