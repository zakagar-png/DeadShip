<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- A puddle of the puker's acid. Harmless, but ugly and it has to be cleaned up, like vomit.
       It borrows the vanilla vomit puddle picture, tinted to match the acid. Swap texPath for own art later. -->
  <ThingDef ParentName="BaseFilth">
    <defName>DS_Filth_Acid</defName>
    <label>necromorph acid</label>
    <statBases>
      <Beauty>-40</Beauty>
      <Cleanliness>-15</Cleanliness>
    </statBases>
    <graphicData>
      <texPath>Things/Filth/PoolSoft</texPath>
      <color>(185, 150, 45, 190)</color>
    </graphicData>
    <filth>
      <ignoreFilthMultiplierStat>true</ignoreFilthMultiplierStat>
      <disappearsInDays>35~40</disappearsInDays>
      <rainWashes>true</rainWashes>
      <cleaningWorkToReduceThickness>70</cleaningWorkToReduceThickness>
      <canFilthAttach>true</canFilthAttach>
      <cleaningSound>Interact_CleanFilth_Fluid</cleaningSound>
    </filth>
  </ThingDef>

</Defs>
