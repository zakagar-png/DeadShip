<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- The puker: a slow, tanky back-line necromorph. It spits acid from range (Source/CompAcidSpit.cs),
       and its melee is weak. Dies when it loses 3 of its 5 limbs OR when its gut sac is destroyed.
       All numbers are placeholders to tune by playing. -->
  <ThingDef ParentName="AnimalThingBase">
    <defName>DS_Puker</defName>
    <label>puker</label>
    <description>A bloated reanimated body that spits corrosive acid from a distance. Its flailing arms are weak, but the acid wounds flesh and eats through armour. It dies if its swollen gut is destroyed, or once its limbs are cut away.</description>
    <statBases>
      <MoveSpeed>3.2</MoveSpeed>
      <ArmorRating_Sharp>0</ArmorRating_Sharp>
      <ArmorRating_Blunt>0</ArmorRating_Blunt>
      <ArmorRating_Heat>0</ArmorRating_Heat>
      <PainShockThreshold>0.99</PainShockThreshold>
      <Wildness>1</Wildness>
      <ComfyTemperatureMin>-100</ComfyTemperatureMin>
      <ComfyTemperatureMax>100</ComfyTemperatureMax>
    </statBases>
    <tools>
      <li>
        <label>left fist</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2.2</cooldownTime>
        <linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
      </li>
      <li>
        <label>right fist</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2.2</cooldownTime>
        <linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
      </li>
      <li>
        <label>teeth</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>10</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        <chanceFactor>0.5</chanceFactor>
      </li>
    </tools>
    <race>
      <thinkTreeMain>Insect</thinkTreeMain>
      <thinkTreeConstant>InsectConstant</thinkTreeConstant>
      <body>DS_PukerBody</body>
      <renderTree>DS_PukerTree</renderTree>
      <herdAnimal>false</herdAnimal>
      <predator>false</predator>
      <baseBodySize>1.3</baseBodySize>
      <baseHealthScale>4</baseHealthScale>
      <baseHungerRate>0.05</baseHungerRate>
      <foodType>None</foodType>
      <trainability>None</trainability>
      <manhunterOnDamageChance>1</manhunterOnDamageChance>
      <manhunterOnTameFailChance>1</manhunterOnTameFailChance>
      <lifeExpectancy>5</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalAdult</def>
          <minAge>0</minAge>
        </li>
      </lifeStageAges>
    </race>
    <tradeability>None</tradeability>
    <comps>
      <!-- Dies at 3 of 5 limbs, or the moment the gut sac is destroyed. Also gives it the zero-pain effect. -->
      <li Class="DeadShip.CompProperties_LimbDeath">
        <limbsToDie>3</limbsToDie>
        <limbDefs>
          <li>DS_Arm</li>
          <li>DS_Leg</li>
          <li>DS_Head</li>
        </limbDefs>
        <killIfLostDefs>
          <li>DS_Gut</li>
        </killIfLostDefs>
      </li>
      <!-- The acid spit. -->
      <li Class="DeadShip.CompProperties_AcidSpit">
        <range>18</range>
        <minRange>3</minRange>
        <warmupTicks>45</warmupTicks>
        <cooldownTicks>240</cooldownTicks>
        <damage>9</damage>
        <armorPenetration>0.2</armorPenetration>
        <armorWear>12</armorWear>
        <hitChanceNear>0.9</hitChanceNear>
        <hitChanceFar>0.45</hitChanceFar>
      </li>
      <!-- Raid tactics: stops back and spits, and fights in melee if an enemy closes in. -->
      <li Class="DeadShip.CompProperties_Tactics">
        <finishDowned>true</finishDowned>
        <keepDistance>true</keepDistance>
        <holdRange>16</holdRange>
        <retreatRange>5</retreatRange>
        <maxRetreats>0</maxRetreats>
      </li>
    </comps>
  </ThingDef>

</Defs>
