<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- The pregnant: a slow, tough body that carries a brood. When it dies, for any reason, the brood bursts out as a swarm (one pawn made of many small bodies)
       (Source/CompSwarmRelease.cs). Dies when both arms are gone, the head is gone or the sac is destroyed. Numbers are placeholders. -->
  <ThingDef ParentName="AnimalThingBase">
    <defName>DS_Pregnant</defName>
    <label>pregnant</label>
    <description>A bloated necromorph that walks on two long blades, its belly packed with the swarm that will replace it. It is slow and hard to put down, and when it dies the brood spills out and goes for the nearest living thing.</description>
    <statBases>
      <MoveSpeed>3.2</MoveSpeed>
      <ArmorRating_Sharp>0</ArmorRating_Sharp>
      <ArmorRating_Blunt>0</ArmorRating_Blunt>
      <ArmorRating_Heat>0</ArmorRating_Heat>
      <PainShockThreshold>0.99</PainShockThreshold>
      <Wildness>1</Wildness>
      <ComfyTemperatureMin>-100</ComfyTemperatureMin>
      <ComfyTemperatureMax>100</ComfyTemperatureMax>
    </statBases>
    <tools>
      <li>
        <label>left blade</label>
        <capacities><li>Cut</li></capacities>
        <power>16</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
        <armorPenetration>0.5</armorPenetration>
      </li>
      <li>
        <label>right blade</label>
        <capacities><li>Cut</li></capacities>
        <power>16</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
        <armorPenetration>0.5</armorPenetration>
      </li>
      <li>
        <label>teeth</label>
        <capacities><li>Bite</li></capacities>
        <power>10</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        <chanceFactor>0.3</chanceFactor>
      </li>
    </tools>
    <race>
      <thinkTreeMain>Insect</thinkTreeMain>
      <thinkTreeConstant>InsectConstant</thinkTreeConstant>
      <body>DS_PregnantBody</body>
      <renderTree>DS_PregnantTree</renderTree>
      <herdAnimal>false</herdAnimal>
      <predator>false</predator>
      <baseBodySize>1.3</baseBodySize>
      <baseHealthScale>3</baseHealthScale>
      <baseHungerRate>0.05</baseHungerRate>
      <foodType>None</foodType>
      <trainability>None</trainability>
      <manhunterOnDamageChance>1</manhunterOnDamageChance>
      <manhunterOnTameFailChance>1</manhunterOnTameFailChance>
      <lifeExpectancy>5</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalAdult</def>
          <minAge>0</minAge>
        </li>
      </lifeStageAges>
    </race>
    <tradeability>None</tradeability>
    <comps>
      <li Class="DeadShip.CompProperties_LimbDeath">
        <limbsToDie>2</limbsToDie>
        <limbDefs>
          <li>DS_Arm</li>
        </limbDefs>
        <killIfLostDefs>
          <li>DS_BroodSac</li>
          <li>DS_Head</li>
        </killIfLostDefs>
      </li>
      <li Class="DeadShip.CompProperties_SwarmRelease">
        <swarmKind>DS_Swarmer</swarmKind>
        <countMin>1</countMin>
        <countMax>1</countMax>
      </li>
    </comps>
  </ThingDef>

  <!-- One of the swarm. One pawn made of many small bodies: fragile, and each bite is weak, but it bites fast. -->
  <ThingDef ParentName="AnimalThingBase">
    <defName>DS_Swarmer</defName>
    <label>swarmer</label>
    <description>A writhing mass of small necromorphs that bursts out of a pregnant. Each bite is minor but there are many of them.</description>
    <statBases>
      <MoveSpeed>5.0</MoveSpeed>
      <MeleeHitChance>3</MeleeHitChance>
      <ArmorRating_Sharp>0</ArmorRating_Sharp>
      <ArmorRating_Blunt>0</ArmorRating_Blunt>
      <ArmorRating_Heat>0</ArmorRating_Heat>
      <PainShockThreshold>0.99</PainShockThreshold>
      <Wildness>1</Wildness>
      <ComfyTemperatureMin>-100</ComfyTemperatureMin>
      <ComfyTemperatureMax>100</ComfyTemperatureMax>
    </statBases>
    <tools>
      <li>
        <label>teeth</label>
        <capacities><li>Bite</li></capacities>
        <power>8</power>
        <cooldownTime>0.7</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
      </li>
    </tools>
    <race>
      <thinkTreeMain>Insect</thinkTreeMain>
      <thinkTreeConstant>InsectConstant</thinkTreeConstant>
      <body>DS_SwarmerBody</body>
      <renderTree>DS_SwarmerTree</renderTree>
      <herdAnimal>false</herdAnimal>
      <predator>false</predator>
      <baseBodySize>0.7</baseBodySize>
      <baseHealthScale>1.2</baseHealthScale>
      <baseHungerRate>0.05</baseHungerRate>
      <foodType>None</foodType>
      <trainability>None</trainability>
      <manhunterOnDamageChance>1</manhunterOnDamageChance>
      <manhunterOnTameFailChance>1</manhunterOnTameFailChance>
      <lifeExpectancy>1</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalAdult</def>
          <minAge>0</minAge>
        </li>
      </lifeStageAges>
    </race>
    <tradeability>None</tradeability>
  </ThingDef>

  <PawnKindDef ParentName="AnimalKindBase">
    <defName>DS_Pregnant</defName>
    <label>pregnant</label>
    <race>DS_Pregnant</race>
    <defaultFactionDef>DS_Necromorphs</defaultFactionDef>
    <combatPower>110</combatPower>
    <canArriveManhunter>false</canArriveManhunter>
    <ecoSystemWeight>0</ecoSystemWeight>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/DS_Pregnant/DS_Pregnant</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>2.0</drawSize>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/DS_Pregnant/DS_Pregnant</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>2.0</drawSize>
          <color>(90,80,70)</color>
        </dessicatedBodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>

  <PawnKindDef ParentName="AnimalKindBase">
    <defName>DS_Swarmer</defName>
    <label>swarmer</label>
    <race>DS_Swarmer</race>
    <defaultFactionDef>DS_Necromorphs</defaultFactionDef>
    <combatPower>25</combatPower>
    <canArriveManhunter>false</canArriveManhunter>
    <ecoSystemWeight>0</ecoSystemWeight>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/DS_Swarmer/DS_Swarmer</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.4</drawSize>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/DS_Swarmer/DS_Swarmer</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.4</drawSize>
          <color>(90,80,70)</color>
        </dessicatedBodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>

</Defs>
