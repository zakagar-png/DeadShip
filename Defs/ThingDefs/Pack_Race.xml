<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- The pack: small, fast, fragile necromorphs made from children. Individually weak, they come in numbers and run people down.
       Two arms and a head, no legs; they die when both arms are gone, or an arm and the head. Numbers are placeholders. -->
  <ThingDef ParentName="AnimalThingBase">
    <defName>DS_Pack</defName>
    <label>pack</label>
    <description>A child's body, remade by the Marker's signal into something small, quick and hungry. One is a nuisance. They never come alone.</description>
    <statBases>
      <MoveSpeed>6.2</MoveSpeed>
      <MeleeHitChance>3</MeleeHitChance>
      <ArmorRating_Sharp>0</ArmorRating_Sharp>
      <ArmorRating_Blunt>0</ArmorRating_Blunt>
      <ArmorRating_Heat>0</ArmorRating_Heat>
      <PainShockThreshold>0.99</PainShockThreshold>
      <Wildness>1</Wildness>
      <ComfyTemperatureMin>-100</ComfyTemperatureMin>
      <ComfyTemperatureMax>100</ComfyTemperatureMax>
    </statBases>
    <tools>
      <li>
        <label>left claw</label>
        <capacities><li>Cut</li></capacities>
        <power>8</power>
        <cooldownTime>0.8</cooldownTime>
        <linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
        <armorPenetration>0.25</armorPenetration>
      </li>
      <li>
        <label>right claw</label>
        <capacities><li>Cut</li></capacities>
        <power>8</power>
        <cooldownTime>0.8</cooldownTime>
        <linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
        <armorPenetration>0.25</armorPenetration>
      </li>
      <li>
        <label>teeth</label>
        <capacities><li>Bite</li></capacities>
        <power>6</power>
        <cooldownTime>1.0</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        <chanceFactor>0.4</chanceFactor>
        <armorPenetration>0.15</armorPenetration>
      </li>
    </tools>
    <race>
      <thinkTreeMain>Insect</thinkTreeMain>
      <thinkTreeConstant>InsectConstant</thinkTreeConstant>
      <body>DS_PackBody</body>
      <renderTree>DS_PackTree</renderTree>
      <herdAnimal>false</herdAnimal>
      <predator>false</predator>
      <baseBodySize>0.6</baseBodySize>
      <baseHealthScale>1.4</baseHealthScale>
      <baseHungerRate>0.05</baseHungerRate>
      <foodType>None</foodType>
      <trainability>None</trainability>
      <manhunterOnDamageChance>1</manhunterOnDamageChance>
      <manhunterOnTameFailChance>1</manhunterOnTameFailChance>
      <lifeExpectancy>5</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalAdult</def>
          <minAge>0</minAge>
        </li>
      </lifeStageAges>
    </race>
    <tradeability>None</tradeability>
    <comps>
      <li Class="DeadShip.CompProperties_LimbDeath">
        <limbsToDie>2</limbsToDie>
        <limbDefs>
          <li>DS_Arm</li>
          <li>DS_Head</li>
        </limbDefs>
      </li>
      <li Class="DeadShip.CompProperties_Tactics">
        <finishDowned>true</finishDowned>
      </li>
    </comps>
  </ThingDef>

  <PawnKindDef ParentName="AnimalKindBase">
    <defName>DS_Pack</defName>
    <label>pack</label>
    <race>DS_Pack</race>
    <defaultFactionDef>DS_Necromorphs</defaultFactionDef>
    <combatPower>35</combatPower>
    <canArriveManhunter>false</canArriveManhunter>
    <ecoSystemWeight>0</ecoSystemWeight>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/DS_Pack/DS_Pack</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.3</drawSize>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/DS_Pack/DS_Pack</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.3</drawSize>
          <color>(90,80,70)</color>
        </dessicatedBodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>

</Defs>
