<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- The puker's swollen gut. It bulges out of the body, so it can be shot, but it is fragile:
       if it is destroyed the puker dies (see killIfLostDefs in Puker_Race.xml). -->
  <BodyPartDef>
    <defName>DS_Gut</defName>
    <label>gut sac</label>
    <hitPoints>45</hitPoints>
    <permanentInjuryChanceFactor>0</permanentInjuryChanceFactor>
    <bleedRate>0</bleedRate>
    <skinCovered>true</skinCovered>
  </BodyPartDef>

  <!-- Same limbs as the slasher (so the 3-of-5 limb rule works the same way) plus the gut sac. -->
  <BodyDef>
    <defName>DS_PukerBody</defName>
    <label>puker</label>
    <corePart>
      <def>DS_Torso</def>
      <height>Middle</height>
      <depth>Outside</depth>
      <parts>
        <li>
          <def>DS_Head</def>
          <coverage>0.10</coverage>
          <height>Top</height>
          <depth>Outside</depth>
          <groups>
            <li>Teeth</li>
          </groups>
        </li>
        <li>
          <def>DS_Arm</def>
          <customLabel>left arm</customLabel>
          <coverage>0.10</coverage>
          <height>Top</height>
          <depth>Outside</depth>
          <groups>
            <li>LeftHand</li>
          </groups>
        </li>
        <li>
          <def>DS_Arm</def>
          <customLabel>right arm</customLabel>
          <coverage>0.10</coverage>
          <height>Top</height>
          <depth>Outside</depth>
          <groups>
            <li>RightHand</li>
          </groups>
        </li>
        <li>
          <def>DS_Leg</def>
          <customLabel>left leg</customLabel>
          <coverage>0.10</coverage>
          <height>Bottom</height>
          <depth>Outside</depth>
        </li>
        <li>
          <def>DS_Leg</def>
          <customLabel>right leg</customLabel>
          <coverage>0.10</coverage>
          <height>Bottom</height>
          <depth>Outside</depth>
        </li>
        <li>
          <def>DS_Gut</def>
          <coverage>0.20</coverage>
          <height>Middle</height>
          <depth>Outside</depth>
        </li>
      </parts>
    </corePart>
  </BodyDef>

</Defs>
