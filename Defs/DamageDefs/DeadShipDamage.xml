<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Plasma cutting: a cut that aims for limbs more often than a normal cut does (Source/DamageWorker_LimbCut.cs).
       The Dead Space weapons use this, so they are the tool for taking limbs off necromorphs. -->
  <DamageDef>
    <defName>DS_PlasmaCut</defName>
    <label>plasma cut</label>
    <workerClass>DeadShip.DamageWorker_LimbCut</workerClass>
    <externalViolence>true</externalViolence>
    <deathMessage>{0} has been cut apart.</deathMessage>
    <hediff>Cut</hediff>
    <harmAllLayersUntilOutside>true</harmAllLayersUntilOutside>
    <impactSoundType>Slice</impactSoundType>
    <armorCategory>Sharp</armorCategory>
    <overkillPctToDestroyPart>0.4~1.0</overkillPctToDestroyPart>
    <isRanged>true</isRanged>
    <makesAnimalsFlee>true</makesAnimalsFlee>
    <modExtensions>
      <li Class="DeadShip.LimbBiasExtension">
        <limbChance>0.6</limbChance>
      </li>
    </modExtensions>
  </DamageDef>

</Defs>
