    <isBad>false</isBad>
    <initialSeverity>0.1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <label>faint</label>
        <minSeverity>0</minSeverity>
        <statOffsets>
          <WorkSpeedGlobal>0.02</WorkSpeedGlobal>
          <ResearchSpeed>0.05</ResearchSpeed>
        </statOffsets>
      </li>
      <li>
        <label>strong</label>
        <minSeverity>0.25</minSeverity>
        <statOffsets>
          <WorkSpeedGlobal>0.12</WorkSpeedGlobal>
          <ResearchSpeed>0.25</ResearchSpeed>
        </statOffsets>
      </li>
      <li>
        <label>intense</label>
        <minSeverity>0.5</minSeverity>
        <statOffsets>
          <WorkSpeedGlobal>0.20</WorkSpeedGlobal>
          <ResearchSpeed>0.45</ResearchSpeed>
        </statOffsets>
      </li>
      <li>
        <label>consuming</label>
        <minSeverity>0.8</minSeverity>
        <statOffsets>
