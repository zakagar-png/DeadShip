  </HediffDef>
  <HediffDef>
    <defName>DS_Air_Sociable</defName>
    <label>sociable air</label>
    <description>A social aerosol in the air. Easier to talk to, easier to persuade.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.4,0.7,1)</defaultLabelColor>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>600</disappearsAfterTicks>
        <showRemainingTime>false</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li><statOffsets><SocialImpact>0.25</SocialImpact><NegotiationAbility>0.15</NegotiationAbility></statOffsets></li>
    </stages>
  </HediffDef>
  <ThoughtDef>
    <defName>DS_EuphoricAirMood</defName>
    <workerClass>ThoughtWorker_Hediff</workerClass>
    <hediff>DS_Air_Euphoric</hediff>
    <stages>
      <li>
        <label>euphoric air</label>
        <description>Something in the air has lifted my mood.</description>
        <baseMoodEffect>8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
</Defs>
