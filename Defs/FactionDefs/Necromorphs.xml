<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <FactionDef ParentName="FactionBase">
    <defName>DS_Necromorphs</defName>
    <label>necromorphs</label>
    <description>Twisted bodies driven by the Marker. They cannot be negotiated with.</description>
    <pawnSingular>necromorph</pawnSingular>
    <pawnsPlural>necromorphs</pawnsPlural>
    <categoryTag>DS_Necromorph</categoryTag>
    <fixedName>Necromorphs</fixedName>
    <factionIconPath>World/WorldObjects/Expanding/Insects</factionIconPath>
    <hidden>true</hidden>
    <humanlikeFaction>false</humanlikeFaction>
    <permanentEnemy>true</permanentEnemy>
    <autoFlee>false</autoFlee>
    <canUseAvoidGrid>false</canUseAvoidGrid>
    <canSiege>false</canSiege>
    <canStageAttacks>false</canStageAttacks>
    <canMakeRandomly>false</canMakeRandomly>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>1100</configurationListOrderPriority>
    <techLevel>Animal</techLevel>
    <earliestRaidDays>2</earliestRaidDays>
    <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
    <allowedArrivalTemperatureRange>-100~200</allowedArrivalTemperatureRange>
    <colorSpectrum>
      <li>(0.6, 0.15, 0.15)</li>
      <li>(0.4, 0.05, 0.05)</li>
    </colorSpectrum>
    <raidCommonalityFromPointsCurve>
      <points>
        <li>(0, 0)</li>
        <li>(40, 1)</li>
        <li>(1000, 1.5)</li>
      </points>
    </raidCommonalityFromPointsCurve>
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(0,100)</li>
        <li>(700,140)</li>
        <li>(100000,10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
    <raidLootValueFromPointsCurve>
      <points>
        <li>(0,0)</li>
        <li>(100000,0)</li>
      </points>
    </raidLootValueFromPointsCurve>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>100</commonality>
        <!-- Animal-bodied necromorphs cannot stage or siege: these strategies find no usable pawns and break the raid. -->
        <disallowedStrategies>
          <li>StageThenAttack</li>
          <li>Siege</li>
        </disallowedStrategies>
        <options>
          <DS_Slasher>10</DS_Slasher>
          <DS_Puker>4</DS_Puker>
          <DS_Lurker>6</DS_Lurker>
          <DS_Exploder>5</DS_Exploder>
          <DS_Leaper>5</DS_Leaper>
          <DS_Pregnant>3</DS_Pregnant>
          <DS_Pack>8</DS_Pack>
          <DS_Brute>2</DS_Brute>
        </options>
      </li>
    </pawnGroupMakers>
  </FactionDef>

</Defs>
